{
  "hosting": {
    "target": "orbis-ai",
    "public": "firebase-dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      { "source": "**", "destination": "/index.html" }
    ]
  },
  "firestore": {
    "database": "orbis-dnc",
    "rules": "firestore.rules"
  }
}
