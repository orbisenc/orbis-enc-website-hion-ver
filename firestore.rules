rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(resource) {
      return resource.data.owner == request.auth.uid;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['collectionId', 'collectionName', 'created', 'updated']) &&
             data.collectionId is string &&
             data.collectionName is string &&
             data.collectionId.size() > 0 &&
             data.collectionName.size() > 0;
    }

    function isValidTask(data) {
      return data.keys().hasAll(['node_id', 'text', 'start', 'end', 'progress', 'type', 'parent', 'maturity']) &&
             data.node_id is string &&
             data.text is string &&
             data.start is string &&
             data.end is string &&
             data.progress is number &&
             data.progress >= 0 &&
             data.progress <= 100 &&
             data.type is string &&
             data.type in ['project', 'phase', 'task', 'milestone-project'] &&
             data.parent is number &&
             data.maturity is string &&
             data.maturity in ['draft', 'planned', 'in_progress', 'completed', 'cancelled'];
    }

    function allowAll() {
      return true;
    }

    match /hionConsentRuntime/private/tenants/{tenantId}/campaigns/{campaignId} {
      allow read, write: if request.auth != null &&
                            request.auth.token.hionServer == true &&
                            request.auth.token.tenantId == tenantId;
    }

    match /list_collections/{document} {
      allow read: if allowAll();
      allow create: if allowAll() &&
                    isValidProject(request.resource.data) &&
                    request.resource.data.created == request.time &&
                    request.resource.data.updated == request.time;
      allow update: if allowAll() &&
                    isValidProject(request.resource.data) &&
                    request.resource.data.created == resource.data.created &&
                    request.resource.data.updated == request.time;
      allow delete: if allowAll();
    }

    match /{projectCollection}/{document} {
      allow read, write: if allowAll() &&
                         projectCollection != 'list_collections' &&
                         projectCollection.size() > 0;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
