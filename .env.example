# PostgreSQL 연결 주소입니다. 운영 비밀번호는 안전한 비밀 저장소에서 관리하세요.
DATABASE_URL="postgresql://hion:hion_dev_only@localhost:5432/hion?schema=public"
# 운영에서는 32바이트 이상의 무작위 값으로 반드시 교체하세요.
SESSION_SECRET="개발에서만-사용하는-HION-세션-비밀"
# 로컬 시연 전용입니다. 운영에서는 반드시 false여야 합니다.
ENABLE_DEVELOPMENT_MOCKS="true"
# 실제 데이터 없이 공개 iframe 시연을 허용할 때만 true로 설정합니다.
ENABLE_PUBLIC_DEMO="false"
# 법률 검토와 승인된 본인확인·전자서명 연동 전에는 false로 유지하세요.
ENABLE_LEGAL_CONSENT="false"
IDENTITY_PROVIDER="mock"
ELECTRONIC_SIGNATURE_PROVIDER="disabled"
STORAGE_PROVIDER="local"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 웹 안에서 외부 웹을 조작하는 격리 브라우저 설정입니다. 운영에서는 명시적으로 활성화하고,
# 게이트웨이를 외부 호스트에 둘 때 앱과 동일한 긴 무작위 토큰을 설정하세요.
ENABLE_REMOTE_BROWSER="false"
REMOTE_BROWSER_GATEWAY_URL="http://127.0.0.1:3100"
REMOTE_BROWSER_GATEWAY_HOST="127.0.0.1"
REMOTE_BROWSER_GATEWAY_PORT="3100"
REMOTE_BROWSER_GATEWAY_TOKEN=""
REMOTE_BROWSER_CHANNEL="chrome"
REMOTE_BROWSER_CDP_URL=""
REMOTE_BROWSER_MAX_SESSIONS="6"
REMOTE_BROWSER_IDLE_TIMEOUT_MS="600000"
REMOTE_BROWSER_ALLOWED_PORTS="80,443"
# 한국어 PDF에 포함할 TTF/OTF 글꼴 경로입니다. Windows에서는 맑은 고딕을 자동 탐색합니다.
KOREAN_PDF_FONT_PATH=""

# Firebase HION Consent 웹 앱의 공개 SDK 설정입니다.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""
# 서버 전용 값입니다. 저장소에 실제 값을 커밋하지 말고 배포 환경의 암호 저장소에 등록하세요.
FIREBASE_SERVICE_ACCOUNT_EMAIL=""
FIREBASE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# ORBIS D&C 공식 웹사이트
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# 운영 문의 전달 시스템의 HTTPS 웹훅과 인증 토큰입니다. 둘 중 하나라도 없으면 문의 API는 503을 반환합니다.
INQUIRY_WEBHOOK_URL=""
INQUIRY_WEBHOOK_TOKEN=""
